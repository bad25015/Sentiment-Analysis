try:
    df = pd.read_excel(file_path)
    # Συνδυασμός Title και Description για πλήρες κείμενο
    df['Full_Review'] = (df['Title'].fillna('') + " " + df['Description'].fillna('')).str.slice(0, 510)

    # Sentiment Analysis (Binary: Positive/Negative)
    print("Βήμα 1: Διαχωρισμός Θετικών και Αρνητικών κριτικών...")
    def get_sentiment(text):
        if not str(text).strip(): return "Negative"
        res = classifier(str(text))[0]
        stars = int(res['label'].split()[0])
        return "Positive" if stars >= 4 else "Negative"

    df['Sentiment'] = df['Full_Review'].apply(get_sentiment)

    # Extraction of Negative N-grams
    print("Βήμα 2: Εντοπισμός των λόγων δυσαρέσκειας...")

    # Ρύθμιση Stopwords
    gr_stops = set(nltk.corpus.stopwords.words('greek'))
    en_stops = set(nltk.corpus.stopwords.words('english'))
    negations = {'not', 'no', 'δεν', 'μην', 'οχι', 'όχι', 'without', 'never', 'poor', 'bad'}
    all_stops = (gr_stops | en_stops) - negations
    all_stops.update(['mall', 'cevahir', 'κέντρο', 'εμπορικό', 'center', 'πολύ', 'ήταν', 'από', 'για'])

    def clean_and_ngram(texts, n):
        words_list = []
        for t in texts:
            # Καθαρισμός στίξης, διατήρηση μόνο λέξεων
            w = re.findall(r'\b\w+\b', t.lower())
            filtered = [word for word in w if word not in all_stops and len(word) > 2]
            grams = ngrams(filtered, n)
            words_list.extend([' '.join(g) for g in grams])
        return words_list

    # Παίρνουμε μόνο τις Αρνητικές
    neg_reviews = df[df['Sentiment'] == "Negative"]['Full_Review']

    # Παραγωγή Bigrams (2 λέξεις) και Trigrams (3 λέξεις)
    neg_bigrams = clean_and_ngram(neg_reviews, 2)
    neg_trigrams = clean_and_ngram(neg_reviews, 3)

    top_reasons = collections.Counter(neg_bigrams).most_common(12)

    # Οπτικοποίηση: Top 12 Reasons for Low Ratings
    plt.figure(figsize=(12, 8))
    reasons_df = pd.DataFrame(top_reasons, columns=['Reason', 'Frequency'])

    sns.barplot(x='Frequency', y='Reason', data=reasons_df, palette='Reds_r')
    plt.title('Top 12 Λόγοι για Χαμηλή Βαθμολογία (Negative Reasons)', fontsize=16)
    plt.xlabel('Αριθμός Αναφορών', fontsize=12)
    plt.ylabel('Θέμα / Φράση', fontsize=12)
    plt.grid(axis='x', linestyle='--', alpha=0.7)
    plt.show()

    # Τελική Αναφορά & Αποθήκευση
    print("\n--- ΣΥΝΟΨΗ ΠΡΟΒΛΗΜΑΤΩΝ (Top Negative Themes) ---")
    for r, count in top_reasons:
        print(f"{r.upper()} (Αναφέρθηκε {count} φορές)")

    output_path = "/content/drive/MyDrive/Negative_Analysis_Report.xlsx"
    df.to_excel(output_path, index=False)
    print(f"\nΗ ανάλυση σώθηκε στο Drive: {output_path}")

except Exception as e:
    print(f"Σφάλμα: {e}")

# Κρατάμε τις αρνητικές για την ανάλυση (π.χ. Rating <= 2)
neg_reviews = df[df['Rating'] <= 2]['Description'].fillna('').astype(str).tolist()

# Φόρτωση Μοντέλου και Tokenizer
model_name = "nlptown/bert-base-multilingual-uncased-sentiment"
model = AutoModelForSequenceClassification.from_pretrained(model_name)
tokenizer = AutoTokenizer.from_pretrained(model_name)

# Δημιουργία pipeline για το SHAP
pred_pipeline = pipeline("sentiment-analysis", model=model, tokenizer=tokenizer, return_all_scores=True)

# Εφαρμογή SHAP
# Ορίζουμε μια συνάρτηση πρόβλεψης που δέχεται κείμενο και επιστρέφει scores
def f(x):
    tv = [pred_pipeline(val) for val in x]
    # Επιστρέφουμε το score για το "1 star" (πολύ αρνητικό)
    return [res[0]['score'] for res in tv]

# Χρησιμοποιούμε τον Explainer για κείμενο
explainer = shap.Explainer(pred_pipeline)

# Παίρνουμε ένα δείγμα από τις αρνητικές κριτικές (τις πρώτες 5)
shap_values = explainer(neg_reviews[:5])

# Οπτικοποίηση
# Ποιες λέξεις (π.χ. "crowded", "dirty", "expensive") ανέβασαν το αρνητικό score
shap.plots.text(shap_values)

from sentence_transformers import SentenceTransformer

from sklearn.cluster import KMeans
# Φόρτωση Μοντέλου που "καταλαβαίνει" νοήματα προτάσεων
model = SentenceTransformer('all-MiniLM-L6-v2')

# Φιλτράρισμα μόνο των πραγματικά αρνητικών (π.χ. Rating 1 & 2)
neg_df = df[df['Rating'] <= 2].copy()
sentences = neg_df['Description'].fillna('').tolist()

# Μετατροπή προτάσεων σε διανύσματα (Embeddings)
embeddings = model.encode(sentences)

# Ομαδοποίηση σε 3-4 κύρια Marketing "Pain Points"
num_clusters = 4
kmeans = KMeans(n_clusters=num_clusters, random_state=42)
neg_df['Cluster'] = kmeans.fit_predict(embeddings)

# Εύρεση της "Αντιπροσωπευτικής Κριτικής" για κάθε Cluster
print("--- MARKETING INSIGHTS PER CLUSTER ---")
for i in range(num_clusters):
    cluster_samples = neg_df[neg_df['Cluster'] == i]['Description'].iloc[:2].values
    print(f"\n📢 GROUP {i+1} (Pain Point):")
    for sample in cluster_samples:
        print(f" - {sample[:150]}...")

# Οπτικοποίηση για την εργασία
plt.figure(figsize=(10, 6))
sns.countplot(x='Cluster', data=neg_df, palette='viridis')
plt.title('Κατανομή Παραπόνων ανά Θεματική Ενότητα', fontsize=14)
plt.xlabel('Cluster Προβλήματος')
plt.ylabel('Αριθμός Κριτικών')
plt.show()

try:
    df = pd.read_excel(file_path)
    df['Title'] = df['Title'].fillna('')
    df['Description'] = df['Description'].fillna('')
    df['Full_Review'] = (df['Title'] + " " + df['Description']).str.slice(0, 510)

    # Sentiment Analysis
    print("Ανάλυση Συναισθήματος...")
    df['Sentiment'] = df['Full_Review'].apply(lambda x: "Positive" if int(classifier(str(x))[0]['label'].split()[0]) >= 4 else "Negative")

    # Advanced Text Mining (Bigrams/Trigrams)
    print("Εξαγωγή N-grams από τις αρνητικές κριτικές...")

    # Προσαρμογή Stopwords:
    greek_stops = set(nltk.corpus.stopwords.words('greek'))
    english_stops = set(nltk.corpus.stopwords.words('english'))
    negation_words = {'δεν', 'μην', 'όχι', 'οχι', 'no', 'not', 'never', 'neither', 'nor', 'without'}

    final_stops = (greek_stops | english_stops) - negation_words
    # Προσθήκη ουδέτερων λέξεων που "θολώνουν" το αποτέλεσμα
    final_stops.update(['mall', 'center', 'cevahir', 'istanbul', 'κέντρο', 'εμπορικό', 'πολύ', 'ήταν'])

    def get_ngrams(text_list, n):
        n_grams_list = []
        for text in text_list:
            # Καθαρισμός στίξης αλλά διατήρηση λέξεων
            words = re.findall(r'\b\w+\b', text.lower())
            # Φιλτράρισμα stopwords (εκτός αρνήσεων)
            filtered = [w for w in words if w not in final_stops and len(w) > 2]

            # Δημιουργία N-grams
            grams = ngrams(filtered, n)
            n_grams_list.extend([' '.join(g) for g in grams])
        return n_grams_list

    # Εστίαση στις Αρνητικές Κριτικές
    negative_texts = df[df['Sentiment'] == "Negative"]['Full_Review']

    # Παίρνουμε Bigrams (n=2) και Trigrams (n=3)
    bigrams = get_ngrams(negative_texts, 2)
    trigrams = get_ngrams(negative_texts, 3)

    top_bigrams = collections.Counter(bigrams).most_common(10)
    top_trigrams = collections.Counter(trigrams).most_common(10)

    # Οπτικοποίηση
    plt.figure(figsize=(15, 8))

    # Bigrams Plot
    plt.subplot(1, 2, 1)
    bg_df = pd.DataFrame(top_bigrams, columns=['Phrase', 'Count'])
    sns.barplot(x='Count', y='Phrase', data=bg_df, palette='OrRd_r')
    plt.title('Top 10 Negative Bigrams (2 λέξεις)')

    # Trigrams Plot
    plt.subplot(1, 2, 2)
    tg_df = pd.DataFrame(top_trigrams, columns=['Phrase', 'Count'])
    sns.barplot(x='Count', y='Phrase', data=tg_df, palette='Reds_r')
    plt.title('Top 10 Negative Trigrams (3 λέξεις)')

    plt.tight_layout()
    plt.show()

    print("\n--- TOP NEGATIVE PHRASES ---")
    for phrase, count in top_bigrams:
        print(f"Phrase: {phrase} | Count: {count}")

except Exception as e:
